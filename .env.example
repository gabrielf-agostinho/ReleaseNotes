# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# Backoffice administrator created on first start.
UMBRACO_ADMIN_NAME=Administrator
UMBRACO_ADMIN_EMAIL=admin@example.com
# At least 10 characters.
UMBRACO_ADMIN_PASSWORD=

# Signs image-processing URLs. Generate one with:
#   openssl rand -base64 64 | tr -d '\n'
#   or PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
UMBRACO_HMAC_SECRET_KEY=

# Create the demo products and releases when the content tree is empty.
RELEASENOTES_DEMO_CONTENT=true
